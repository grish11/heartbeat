# WalletConnect / Reown project id. Free, from https://dashboard.reown.com
# Required by RainbowKit's getDefaultConfig, but only actually used when someone
# connects a phone wallet via QR code. Browser extensions ignore it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Pinata JWT — SERVER SIDE ONLY, never prefixed NEXT_PUBLIC_.
# One account for the whole app; users never make their own.
# https://app.pinata.cloud -> API Keys -> New Key
# Without this, encrypted files fall back to this browser's localStorage and
# the CID is a fake "local-..." string.
PINATA_JWT=

# Optional: your Pinata dedicated gateway. Any of these forms work — the app
# adds the scheme and /ipfs/ path if you leave them off:
#   xyz.mypinata.cloud
#   https://xyz.mypinata.cloud
#   https://xyz.mypinata.cloud/ipfs/
# Falls back to public gateways when unset.
NEXT_PUBLIC_IPFS_GATEWAY=

# Only used to prefill the "open an existing switch" box in local dev.
NEXT_PUBLIC_HEARTBEAT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Infura API key. One key serves every chain — the code varies the subdomain.
# Each network must also be enabled on the key in the Infura dashboard, and
# every origin (including http://localhost:3000) added to its allowlist, or
# requests come back 403 and every read fails silently.
# NOTE: NEXT_PUBLIC_ means this ships to the browser. Normal for RPC keys;
# restrict it by origin so nobody else spends your quota.
NEXT_PUBLIC_INFURA_KEY=

# Set to "sepolia" for a deployed site, so visitors don't default to a local
# anvil node that only exists on the developer's machine. Leave unset locally.
NEXT_PUBLIC_DEFAULT_CHAIN=
